# Local/test database only. Runtime validation rejects unsafe database targets.
NODE_ENV=development
DATABASE_URL=postgresql://alsamad:alsamad_local_only@127.0.0.1:55432/alsamad_local
DATABASE_SSL=false

# Quran.Foundation credential gate (M5.2B, ALSAMAD_IMPLEMENTATION_ROADMAP.md).
# Placeholder names only -- never put a real value in this tracked file. Real
# values belong only in a gitignored local .env.local or the hosting secret
# store, never here, never in chat/tickets/commits. No default is authorized:
# QURAN_FOUNDATION_ENVIRONMENT must be exactly "sandbox" or "production".
# Missing/incomplete selected-environment credentials fail closed; there is
# no fallback between environments.
QURAN_FOUNDATION_ENVIRONMENT=
QURAN_FOUNDATION_SANDBOX_CLIENT_ID=
QURAN_FOUNDATION_SANDBOX_CLIENT_SECRET=
QURAN_FOUNDATION_PRODUCTION_CLIENT_ID=
QURAN_FOUNDATION_PRODUCTION_CLIENT_SECRET=
